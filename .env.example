# ─────────────────────────────────────────────────────────────
# API key de WeatherAPI.com — SOLO SERVIDOR
# Sin prefijo NEXT_PUBLIC_: la key nunca debe llegar al navegador.
# Las rutas /api/weather y /api/search hacen de proxy.
# Consíguela gratis en https://www.weatherapi.com/
# ─────────────────────────────────────────────────────────────
WEATHERAPI_KEY=tu_api_key_aqui

# Días de pronóstico a pedir (el plan gratuito admite hasta 3)
WEATHER_FORECAST_DAYS=3

# ─────────────── Variables públicas (llegan al navegador) ───────────────

# Cada cuántos minutos se refrescan los datos automáticamente
NEXT_PUBLIC_REFRESH_MINUTES=10

# Zoom inicial del mapa
NEXT_PUBLIC_MAP_ZOOM=11
